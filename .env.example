# ScoutOSS environment. `make up` copies this to .env and fills every CHANGE_ME
# with a random value (scripts/init-env.sh). Never commit .env.
COMPOSE_PROJECT_NAME=scoutoss
ENV=dev
LOG_LEVEL=INFO

# ---- host ports (all bound to 127.0.0.1) -------------------------------------
HTTPS_PORT=24443          # nginx: https://{app,xnat,auth,dashboards,grafana,jaeger,notebooks}.localhost:24443
DICOM_PORT=24112          # de-identification gateway C-STORE SCP (AE: SCOUTGW)
MLLP_PORT=26661           # Mirth HL7 MLLP listener
PUBLIC_HOST=localhost
PUBLIC_SCHEME=https

# ---- projects -------------------------------------------------------------------
DEFAULT_PROJECT=SCOUT_DEMO

# ---- databases (scout-db: platform; xnat-db: XNAT) ------------------------------
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME
SCOUT_APP_DB_PASSWORD=CHANGE_ME
DEID_DB_PASSWORD=CHANGE_ME
COPILOT_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_PASSWORD=CHANGE_ME
MIRTH_DB_PASSWORD=CHANGE_ME
XNAT_DB_PASSWORD=CHANGE_ME

# ---- de-identification secrets ---------------------------------------------------
DEID_HMAC_SALT=CHANGE_ME              # site salt for HMAC-SHA256 pseudonyms
DEID_VAULT_KEY=CHANGE_ME_BASE64_32    # AES-256-GCM key for the re-identification vault

# ---- XNAT -------------------------------------------------------------------------
XNAT_ADMIN_PASSWORD=CHANGE_ME
XNAT_INDEXER_PASSWORD=CHANGE_ME
XNAT_PIPELINE_PASSWORD=CHANGE_ME
XNAT_ARCHIVER_PASSWORD=CHANGE_ME
XNAT_MAX_HEAP=3g
# Where to find plugin jars if they cannot be downloaded (see scripts/fetch-xnat-plugins.sh)
XNAT_PLUGIN_CACHE=
OHIF_PLUGIN_URL=https://bitbucket.org/icrimaginginformatics/ohif-viewer-xnat-plugin/downloads/ohif-viewer-3.7.1-fat.jar

# ---- Keycloak ---------------------------------------------------------------------
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
KC_COPILOT_CLIENT_SECRET=CHANGE_ME
KC_INDEXER_CLIENT_SECRET=CHANGE_ME
KC_MIRTH_CLIENT_SECRET=CHANGE_ME
KC_DASHBOARDS_CLIENT_SECRET=CHANGE_ME
KC_NOTEBOOKS_CLIENT_SECRET=CHANGE_ME
OAUTH2_PROXY_COOKIE_SECRET=CHANGE_ME_COOKIE
# Demo users created in the realm (researcher / viewer / admin)
DEMO_USER_PASSWORD=CHANGE_ME

# ---- service-to-service --------------------------------------------------------
INDEXER_WEBHOOK_TOKEN=CHANGE_ME
MIRTH_ADMIN_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ---- copilot LLM -------------------------------------------------------------------
# heuristic: offline rule-based planner (default, no network, no data leaves the host)
# azure: Azure OpenAI (AZURE_OPENAI_*); openai_compatible: vLLM / llama.cpp / Ollama (LLM_BASE_URL)
LLM_PROVIDER=heuristic
LLM_MODEL=gpt-4o
LLM_BASE_URL=
LLM_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_API_KEY=
