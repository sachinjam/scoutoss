# ScoutOSS edge proxy (TLS termination). Rendered by the nginx image's envsubst step.
#   https://app.localhost:${HTTPS_PORT}   UI, /api/copilot, /dashboards, /grafana, /jaeger,
#                                          /prometheus, /notebooks (one origin -> no 3rd-party cookies)
#   https://xnat.localhost:${HTTPS_PORT}  XNAT + OHIF viewer
#   https://auth.localhost:${HTTPS_PORT}  Keycloak
resolver 127.0.0.11 valid=10s ipv6=off;
server_tokens off;
client_max_body_size 0;
proxy_read_timeout 300s;
proxy_send_timeout 300s;

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

log_format json_combined escape=json '{"ts":"$time_iso8601","level":"info","service":"proxy",'
  '"env":"dev","trace_id":"$http_traceparent","msg":"request","endpoint":"$uri",'
  '"method":"$request_method","status":$status,"latency_ms":$request_time,'
  '"host":"$host","bytes":$body_bytes_sent}';
access_log /dev/stdout json_combined;

ssl_certificate     /etc/nginx/certs/fullchain.crt;
ssl_certificate_key /etc/nginx/certs/server.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:TLS:10m;

server {
  listen 8443 ssl default_server;
  http2 on;
  server_name localhost;
  return 301 https://app.localhost:${HTTPS_PORT}$request_uri;
}

server {
  listen 8443 ssl;
  http2 on;
  server_name app.localhost;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  set $ui           http://ui:8080;
  set $copilot      http://copilot:8000;
  set $oauth2       http://oauth2-proxy:4180;
  set $dashboards   http://opensearch-dashboards:5601;
  set $grafana      http://grafana:3000;
  set $jaeger       http://jaeger:16686;
  set $prometheus   http://prometheus:9090;
  set $notebooks    http://notebooks:8000;

  proxy_set_header Host              $host;
  proxy_set_header X-Real-IP         $remote_addr;
  proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto https;
  proxy_set_header X-Forwarded-Host  $host:${HTTPS_PORT};
  proxy_set_header X-Forwarded-Port  ${HTTPS_PORT};
  # oauth2-proxy's session cookie carries the Keycloak tokens; with project groups it outgrows
  # nginx's default 4-8k header buffer ("upstream sent too big header" -> 502 on /oauth2/callback).
  proxy_buffer_size       32k;
  proxy_buffers           8 32k;
  proxy_busy_buffers_size 64k;

  location / {
    proxy_pass $ui;
  }

  # Copilot API (Bearer JWT). Streaming answers: no buffering.
  location /api/copilot/ {
    rewrite ^/api/copilot/(.*)$ /$1 break;
    proxy_pass $copilot;
    proxy_buffering off;
    proxy_cache off;
    proxy_set_header Connection "";
    proxy_http_version 1.1;
  }

  # ---- oauth2-proxy (Keycloak) guards the tool UIs below
  location /oauth2/ {
    proxy_pass $oauth2;
    proxy_set_header X-Auth-Request-Redirect $request_uri;
  }
  location = /oauth2/auth {
    internal;
    proxy_pass $oauth2;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
  }
  location @signin {
    return 302 https://app.localhost:${HTTPS_PORT}/oauth2/start?rd=$request_uri;
  }

  location /dashboards/ {
    auth_request /oauth2/auth;
    error_page 401 = @signin;
    auth_request_set $user $upstream_http_x_auth_request_preferred_username;
    proxy_set_header X-Forwarded-User $user;
    proxy_hide_header X-Frame-Options;
    add_header Content-Security-Policy "frame-ancestors 'self'" always;
    proxy_pass $dashboards;
  }
  location /jaeger/ {
    auth_request /oauth2/auth;
    error_page 401 = @signin;
    proxy_pass $jaeger;
  }
  location /prometheus/ {
    auth_request /oauth2/auth;
    error_page 401 = @signin;
    proxy_pass $prometheus;
  }
  location /grafana/ {
    proxy_pass $grafana;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
  location /notebooks/ {
    proxy_pass $notebooks;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name xnat.localhost;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  set $xnat http://xnat-web:8080;
  location / {
    proxy_pass $xnat;
    proxy_set_header Host              $host:${HTTPS_PORT};
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_redirect http://$host:${HTTPS_PORT}/ https://$host:${HTTPS_PORT}/;
    proxy_redirect http://xnat-web:8080/ https://$host:${HTTPS_PORT}/;
  }
}

server {
  listen 8443 ssl;
  http2 on;
  server_name auth.localhost;
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  set $keycloak http://keycloak:8080;
  location / {
    proxy_pass $keycloak;
    proxy_set_header Host              $host;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  ${HTTPS_PORT};
    proxy_buffer_size 128k;
    proxy_buffers 4 256k;
  }
}
